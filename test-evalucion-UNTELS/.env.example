# Local: PGlite en carpeta. Producción: URL *pooled* de Neon (postgresql://...-pooler...)
DATABASE_URL=pglite://./.data/dev
# https en producción (p. ej. https://mi-app.vercel.app)
APP_URL=http://localhost:3000
# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=
# Google Cloud > Credenciales > ID de cliente OAuth (aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: encabezado con la IP real si hay un proxy delante (Vercel ya pone x-real-ip)
TRUSTED_IP_HEADER=
